{
    "name": "routir/routir",
    "description": "Framework-agnostic, Laravel-inspired HTTP router with interpreted and AOT compiled execution modes.",
    "type": "library",
    "keywords": [
        "router",
        "routing",
        "http",
        "aot",
        "compiler",
        "psr-7",
        "psr-11",
        "psr-15",
        "psr-17"
    ],
    "homepage": "https://github.com/chaungoclong/routir",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/chaungoclong/routir/issues",
        "source": "https://github.com/chaungoclong/routir"
    },
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Routir\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routir\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/routir"
    ],
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
